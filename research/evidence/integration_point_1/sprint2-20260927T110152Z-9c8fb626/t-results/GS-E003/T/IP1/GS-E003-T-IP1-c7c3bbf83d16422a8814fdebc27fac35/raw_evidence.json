f.write(b'\\xef\\xbb\\xbf') # UTF-8 BOM f.write(b'\"hello\",\"Hello\"\\n') # Try to load translations - this will fail tornado.locale.load_translations(tmpdir) ``` This raises: ``` UnicodeError: UTF-16 stream does not start with BOM ``` The issue occurs because the BOM detection logic is reversed - files with UTF-16 BOMs are being treated as UTF-8, while files with UTF-8 BOMs (or no BOM) are being treated as UTF-16.\nPlanned tool: edit_file\nPlanned operation: edit_file\nRuntime: docker\nEnvironment:\nversion:python=3.12.1","query_version":"v1","selected_pattern":{"applicability_operation":"edit_file","applicability_tool":"edit_file","created_at":"2026-09-23T12:09:33.629586Z","embedding":[0.013037697412073612,0.07144711166620255,0.06551367789506912,-0.008300003595650196,-0.0981798768043518,-0.03928754851222038,-0.011260699480772018,0.03957938402891159,-0.042424123734235764,0.0009765878785401583,0.0919690802693367,-0.11927400529384613,0.019471829757094383,0.026180541142821312,-0.05536183714866638,-0.05876876041293144,-0.020409969612956047,0.035792961716651917,0.023714527487754822,-0.052685901522636414,0.003567157546058297,-0.02380583994090557,-0.02764972485601902,0.05918576940894127,0.01779298111796379,-0.043559227138757706,-0.03600704297423363,0.002254935447126627,0.04193519428372383,-0.037998996675014496,-0.02516346238553524,0.113826222717762,-0.06052501127123833,0.009643472731113434,0.09052526950836182,0.03332207724452019,-0.04238903895020485,0.02365846000611782,-0.007613412570208311,0.017063191160559654,-0.011272512376308441,0.021181391552090645,0.08358178287744522,-0.018956150859594345,-0.003968420904129744,-0.044514842331409454,0.024584073573350906,0.032144080847501755,0.039020415395498276,-0.007937896065413952,0.09034959971904755,0.04990468919277191,-0.05716067552566528,-0.10419143736362457,0.039390236139297485,-0.01269907783716917,0.042146265506744385,0.04603315889835358,-0.002857259241864085,0.056430064141750336,-0.02574051357805729,0.04318826645612717,-0.05